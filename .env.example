# Resend — required for /sms quote form and /contact form
RESEND_API_KEY=re_xxxxxxxx

# Inbox that receives quote + contact notifications
SMS_QUOTE_TO=frontdesk@kemsidigital.com
CONTACT_TO=frontdesk@kemsidigital.com

# Must use a verified Resend domain in production
# Example: KemisEMAIL Quotes <quotes@kemis.email>
SMS_QUOTE_FROM=KemisEMAIL Quotes <onboarding@kemis.email>
CONTACT_FROM=KemisEMAIL Contact <onboarding@kemis.email>

# Cloudflare Turnstile (CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAA...
